{
  "name": "opencode-right-preview",
  "version": "0.2.1",
  "type": "module",
  "description": "OpenCode v2 TUI plugin: right-side file launcher panel for files referenced/mentioned in the current session — click to open in your local editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CR903/opencode-right-preview.git"
  },
  "bugs": {
    "url": "https://github.com/CR903/opencode-right-preview/issues"
  },
  "homepage": "https://github.com/CR903/opencode-right-preview#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "tui",
    "file-browser",
    "file-launcher",
    "editor",
    "diff"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun run scripts/build.mjs",
    "prepublishOnly": "bun run build",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "dependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "@types/node": "^22",
    "solid-js": ">=1.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}